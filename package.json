{
  "name": "@coela/portfolio",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "10.29.3"
  },
  "scripts": {
    "site": "nuxtjp-localized-site site",
    "validate:content": "nuxtjp-localized-site site check",
    "test": "node site/check.mjs && node --test site/*.test.mts site/experience.cases.mts && node --test scripts/dependency-security.check.cjs",
    "typecheck": "nuxtjp-localized-site site typecheck coela",
    "build": "nuxtjp-localized-site site build coela",
    "dev": "nuxtjp-localized-site site dev coela",
    "preview": "nuxtjp-localized-site site preview coela",
    "test:dependency-security": "node --test scripts/dependency-security.check.cjs",
    "test:site-structure": "node site/check.mjs"
  },
  "dependencies": {
    "@nuxtjp/contact-form": "0.1.0",
    "@nuxtjp/localized-site": "0.5.0",
    "nuxt": "4.6.2",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@nuxtjp/dependency-security": "0.2.1",
    "@types/node": "24.19.2",
    "@zixcel/provider-cloudflare": "0.2.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13",
    "wrangler": "4.151.1"
  },
  "pnpm": {
    "overrides": {
      "@nuxt/devtools>simple-git": "4.0.2",
      "simple-git": "4.0.2",
      "@simple-git/argv-parser": "2.0.1",
      "esbuild": "0.28.2",
      "undici@6": "6.29.1",
      "undici@7": "7.30.1",
      "undici@8": "8.12.2",
      "serialize-javascript@7": "7.1.3",
      "fast-uri@3": "3.1.9"
    },
    "patchedDependencies": {
      "braces@3.0.3": ".nuxtjp-security/braces-3.0.3.patch",
      "node-forge@1.4.0": ".nuxtjp-security/node-forge-1.4.0.patch"
    }
  },
  "description": "Coela engineering portfolio: live interfaces, architecture and reproducible verification."
}
